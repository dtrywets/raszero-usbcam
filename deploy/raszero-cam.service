[Unit]
Description=RasZero USB camera web UI and control
After=network-online.target mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=ladwein
Group=video
SupplementaryGroups=video
WorkingDirectory=/opt/raszero-usbcam/app
Environment=RASZERO_DEVICE=/dev/video0
Environment=RASZERO_HOST=raszero
Environment=RASZERO_OSD_TIMESTAMP=1
Environment=RASZERO_PORT=8080
Environment=RASZERO_HOST_BIND=0.0.0.0
ExecStart=/opt/raszero-usbcam/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
