[Unit]
Description=MediaMTX RTSP server for RasZero USB cam
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ladwein
Group=video
SupplementaryGroups=video
ExecStart=/usr/local/bin/mediamtx /etc/raszero-usbcam/mediamtx.yml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
